# M.J.B.S AI configuration
GEMINI_API_KEY=your_api_key_here
# Optional: defaults to the provider's standard model.
GEMINI_MODEL=gemini-3.5-flash

# IA local opcional no SSD externo. "auto" prioriza o modelo local quando ativo
# e usa Gemini como fallback; "local" mantém tudo offline; "cloud" ignora o SSD.
MJBS_AI_MODE=auto
MJBS_OFFLINE_ROOT=E:\MJBS_OFFLINE
MJBS_OFFLINE_ENDPOINT=http://127.0.0.1:8081
